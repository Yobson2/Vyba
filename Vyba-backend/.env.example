# =============================================================================
# Application
# =============================================================================
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=password
DB_NAME=app_db

# SSL for managed databases (staging/production)
# DB_SSL_REJECT_UNAUTHORIZED=false
# DB_CA_CERT=
# DB_POOL_SIZE=5

# =============================================================================
# JWT Authentication
# =============================================================================
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-too-in-production

# =============================================================================
# Redis
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# SMS (phone-OTP delivery)
# =============================================================================
# No vendor is wired yet — FakeSmsProvider is used in every environment until
# an Africa-focused provider is integrated (see docs/validation-mvp). Recorded
# here as the shape the real provider's config will take.
# SMS_PROVIDER_API_KEY=
# SMS_SENDER_ID=Vyba

# SSL for managed Redis (staging/production)
# REDIS_SSL_REJECT_UNAUTHORIZED=false

# =============================================================================
# S3 Storage (MinIO for development)
# =============================================================================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=app-storage
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000
# MAX_FILE_SIZE=10485760

# =============================================================================
# Firebase (optional - app starts without it)
# =============================================================================
# Option 1: Environment variables
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=

# Option 2: Base64-encoded service account JSON
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# Option 3: Place serviceAccountKey.json in project root

# =============================================================================
# Mail (SMTP)
# =============================================================================
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_FROM="App Team" <noreply@example.com>

# =============================================================================
# Docker
# =============================================================================
RUNNING_IN_DOCKER=false
