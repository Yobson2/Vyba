# Server-side (RSC) fetches to the Vyba public API. Vyba-backend defaults to
# port 3000; this app runs on 3001 (`npm run dev`) to avoid the clash —
# add http://localhost:3001 to the backend's CORS_ORIGINS for local dev.
API_BASE_URL=http://localhost:3000

# Same value, exposed to the browser for the client-side attribution/analytics
# and "J'y vais" calls (components/AttributionCapture.tsx, GoingSection.tsx).
# Never put a secret here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# The Play Store listing for the app-download prompt (ticket 16), shown only
# after a completed "J'y vais". Unset until the app is published — the
# prompt just doesn't render (components/AppDownloadPrompt.tsx).
# NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.vyba.app
