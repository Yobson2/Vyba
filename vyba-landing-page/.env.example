# Copy to .env.local and fill in. All values are public (NEXT_PUBLIC_*) — never put secrets here.

# Production origin, used for canonical URLs, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://example.com

# Google Play listing. Unset => CTAs show "Bientôt sur Google Play" (inert).
NEXT_PUBLIC_PLAY_STORE_URL=

# WhatsApp Business number, international format (e.g. 225XXXXXXXXXX).
# Unset => venue-owner CTA shows "WhatsApp bientôt disponible" (inert).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional contact email, shown on the privacy page.
NEXT_PUBLIC_CONTACT_EMAIL=
